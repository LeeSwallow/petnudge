{
  "name": "lofi-study-companion-desktop",
  "version": "0.1.0",
  "private": true,
  "main": "dist/main.js",
  "scripts": {
    "build": "node build.mjs",
    "start": "node build.mjs && electron .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "bake": "node scripts/bake-character.mjs miso",
    "dist:mac": "node build.mjs && electron-builder --mac dmg zip",
    "dist:win": "node build.mjs && electron-builder --win nsis",
    "build:character": "node scripts/build-character.mjs lila",
    "watch:character": "node scripts/build-character.mjs lila --watch"
  },
  "devDependencies": {
    "@modelcontextprotocol/node": "^2.1.0",
    "@modelcontextprotocol/server": "^2.1.0",
    "@types/node": "^22.20.5",
    "electron": "^41.10.7",
    "electron-builder": "^26.0.12",
    "esbuild": "0.24.0",
    "galmuri": "^2.40.3",
    "typescript": "~5.6.3",
    "vitest": "^2.1.9",
    "zod": "^4.6.5",
    "zustand": "^5.0.3"
  },
  "description": "Pixel-art study companion desktop pet with pomodoro, todos, notes and music",
  "author": "leeswallow",
  "build": {
    "appId": "com.studycompanion.pet",
    "productName": "Study Companion Pet",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        "dmg",
        "zip"
      ],
      "identity": null
    },
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Study Companion Pet"
    }
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.300",
    "@langchain/anthropic": "^1.5.12",
    "@langchain/core": "^1.2.17",
    "@langchain/openai": "^1.6.2"
  }
}
